# Copy this file to .env and fill in real values before running docker-compose.

# --- Lovable AI Gateway -------------------------------------------------------
# Obtain from Lovable > Cloud > AI Gateway (or your workspace admin).
LOVABLE_API_KEY=replace-me

# --- JWT ---------------------------------------------------------------------
# Generate with:  openssl rand -hex 64
JWT_SECRET=replace-with-a-long-random-hex-string-at-least-64-chars
JWT_EXPIRATION_MINUTES=60

# --- Database (defaults match docker-compose) --------------------------------
POSTGRES_DB=escorts_kubota
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Vector store ------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6334
